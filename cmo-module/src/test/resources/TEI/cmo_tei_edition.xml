    <body>
      <div type="newPieceStart">
        <milestone unit="cite" source="#cmo_mods_00000719"/>
        <msDesc>
          <msIdentifier>
            <idno>TR-Iüne 204-2</idno>
          </msIdentifier>
          <msContents>
            <msItem n="144">
              <locus from="190" to="190">p. 190</locus>
              <rubric type="pieceNumber" subtype="red-pencil">144</rubric>
              <incipit>
                <supplied reason="derived-from-lyrics" cert="1" resp="#ND">Dildārı görüb naġme-i şehnāz ėdelim gel</supplied>
              </incipit>
            </msItem>
          </msContents>
        </msDesc>
      </div>
      <div type="blockLyricsTranscription" rend="direction:ltr;">
        <head n="1"><anchor xml:id="w7176s"/><anchor xml:id="w7174s"/>Semāʿī<anchor xml:id="w7174e"/>Ḥāfıẓ Rifʿat<anchor xml:id="w7176e"/>
            </head>
        <lg n="1" decls="hezec1" rhyme="a-a-b-a">
          <l n="1">
            <seg type="vocal" ana="mainPartLyrics">Dildārı görüb naġme-i şehnāz ėdelim gel</seg>
          </l>
          <l n="2">
            <seg type="vocal" ana="mainPartLyrics">Muṭrib demidir nāle ve <anchor xml:id="w7192s"/>āġāz<anchor xml:id="w7192e"/> ėdelim gel</seg>
          </l>
          <l n="3" real="--u|u-Iu|uI-u|UI-|">
            <seg type="vocal" ana="mainPartLyrics">Ben bāde-i ʿaşḳ <anchor xml:id="w7198s"/>ile<anchor xml:id="w7198e"/> mey-i naḫvet <anchor xml:id="w7201s"/>ile<anchor xml:id="w7201e"/> sen</seg>
          </l>
          <l n="4">
            <seg type="vocal" ana="mainPartLyrics">Mestāne niyāz eyleyelim nāz ėdelim gel</seg>
          </l>
          <l n="5">
            <seg type="vocal" ana="terennüm">ʿömrüm amān cānım āh ėdelim gel</seg>
          </l>
        </lg>
      </div>
    </body>
